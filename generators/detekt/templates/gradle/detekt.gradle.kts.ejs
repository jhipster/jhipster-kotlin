@file:Suppress("UNCHECKED_CAST")

import org.gradle.api.file.ConfigurableFileCollection
import org.gradle.api.file.RegularFileProperty
import org.gradle.api.provider.Property

// Spring dependency management must not replace detekt's embedded Kotlin compiler.
configurations.named("detekt") {
    resolutionStrategy.eachDependency {
        if (requested.group == "org.jetbrains.kotlin") {
            useVersion(requireNotNull(requested.version))
        }
    }
}

fun Any.invokeSingleArgumentMethod(name: String, argument: Any?) {
    javaClass.methods
        .first { it.name == name && it.parameterTypes.size == 1 }
        .invoke(this, argument)
}

fun Any.invokeTwoArgumentMethod(name: String, first: Any?, second: Any?) {
    javaClass.methods
        .first { it.name == name && it.parameterTypes.size == 2 }
        .invoke(this, first, second)
}

val detektExtension = project.extensions.getByName("detekt")
detektExtension.invokeSingleArgumentMethod("setToolVersion", "<%- javaDependencies['detekt-cli'] %>")
detektExtension.invokeSingleArgumentMethod("setIgnoreFailures", false)
(detektExtension.javaClass.methods.first { it.name == "getSource" }.invoke(detektExtension) as ConfigurableFileCollection)
    .setFrom("src/main/kotlin")
(detektExtension.javaClass.methods.first { it.name == "getConfig" }.invoke(detektExtension) as ConfigurableFileCollection)
    .setFrom("<%= detektConfigFile %>")

tasks.named("detekt") {
    val reports = javaClass.methods.first { it.name == "getReports" }.invoke(this)
    val checkstyle = reports.javaClass.methods.first { it.name == "getCheckstyle" }.invoke(reports)
    (checkstyle.javaClass.methods.first { it.name == "getRequired" }.invoke(checkstyle) as Property<Boolean>).set(true)
    (checkstyle.javaClass.methods.first { it.name == "getOutputLocation" }.invoke(checkstyle) as RegularFileProperty)
        .set(layout.buildDirectory.file("reports/detekt/detekt.xml"))
}

val sonarqubeExtension = project.extensions.findByName("sonarqube")
if (sonarqubeExtension != null) {
    val properties = mapOf("sonar.kotlin.detekt.reportPaths" to layout.buildDirectory.file("reports/detekt/detekt.xml").get().asFile.path)
    sonarqubeExtension.javaClass.methods
        .first { it.name == "properties" && it.parameterTypes[0] == Action::class.java }
        .invoke(
            sonarqubeExtension,
            object : Action<Any> {
                override fun execute(extension: Any) {
                    properties.forEach { (key, value) -> extension.invokeTwoArgumentMethod("property", key, value) }
                }
            },
        )
}
