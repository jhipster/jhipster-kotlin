// Spring dependency management must not replace detekt's embedded Kotlin compiler.
configurations.named("detekt") {
    resolutionStrategy.eachDependency {
        if (requested.group == "org.jetbrains.kotlin") {
            useVersion(requested.version)
        }
    }
}

detekt {
    toolVersion = "<%- javaDependencies['detekt-cli'] %>"
    ignoreFailures = false
    source.setFrom("src/main/kotlin")
    config.setFrom("<%= detektConfigFile %>")
}

// detekt 1.x embeds a Kotlin compiler that crashes when it runs inside a Gradle JVM on JDK 25
// ("IllegalArgumentException: 25.0.x"). Run detekt-cli in a forked JVM instead, as the Maven build does.
def detektCli = tasks.register("detektCli", JavaExec) {
    group = "verification"
    description = "Runs detekt in a forked JVM."
    classpath = configurations.named("detekt").get()
    mainClass = "io.gitlab.arturbosch.detekt.cli.Main"
    args = [
        "--input", file("src/main/kotlin").absolutePath,
        "--config", file("<%= detektConfigFile %>").absolutePath,
        "--report", "xml:${buildDir}/reports/detekt/detekt.xml",
    ]
}

tasks.named("detekt").configure {
    enabled = false
    dependsOn(detektCli)
}

sonarqube {
    properties {
        property "sonar.kotlin.detekt.reportPaths", "$buildDir/reports/detekt/detekt.xml"
    }
}
