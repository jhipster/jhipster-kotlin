package <%= packageName %>.config

<%_ if (databaseMigrationLiquibase) { _%>
import com.datastax.oss.driver.api.core.CqlIdentifier
import com.datastax.oss.driver.api.core.cql.SimpleStatement
import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty
import org.springframework.boot.cassandra.autoconfigure.CassandraProperties
import org.springframework.boot.cassandra.autoconfigure.CqlSessionBuilderCustomizer
import java.time.Duration
<%_ } _%>
import com.datastax.oss.driver.api.core.data.TupleValue
import com.datastax.oss.driver.api.core.type.DataTypes
import com.datastax.oss.driver.api.core.type.TupleType
import org.slf4j.LoggerFactory

import org.springframework.context.annotation.Bean
import org.springframework.context.annotation.Configuration
import org.springframework.core.convert.converter.Converter
import org.springframework.data.cassandra.core.convert.CassandraCustomConversions
import org.springframework.data.convert.ReadingConverter
import org.springframework.data.convert.WritingConverter

import jakarta.annotation.Nonnull
import java.time.Instant
import java.time.ZoneId
import java.time.ZonedDateTime
import java.util.ArrayList
import java.util.List

@Configuration
class DatabaseConfiguration {

    private val log = LoggerFactory.getLogger(javaClass)
<%_ if (databaseMigrationLiquibase) { _%>

    /**
     * Creates the keyspace when it does not exist yet, disable it with `application.cassandra.create-keyspace=false`
     * when the keyspace is managed outside of the application.
     * The application session is bound to the keyspace, so the keyspace is created through a keyspace-less session
     * before the application session connects. Liquibase creates the tables once the session is available.
     */
    @Bean
    @ConditionalOnProperty(name = ["application.cassandra.create-keyspace"], havingValue = "true", matchIfMissing = true)
    fun keyspaceCreator(cassandraProperties: CassandraProperties, applicationProperties: ApplicationProperties) =
        CqlSessionBuilderCustomizer { builder ->
            val keyspaceName = cassandraProperties.keyspaceName
            builder.withKeyspace(null as CqlIdentifier?).build().use { session ->
                session.execute(
                    SimpleStatement.newInstance(
                        "CREATE KEYSPACE IF NOT EXISTS $keyspaceName WITH replication = ${applicationProperties.cassandra.keyspaceReplication}",
                    ).setTimeout(Duration.ofSeconds(KEYSPACE_CREATION_TIMEOUT_SECONDS)),
                )
            }
            builder.withKeyspace(keyspaceName)
        }
<%_ } _%>

    @Bean
    fun cassandraCustomConversions() =
        CassandraCustomConversions(
            mutableListOf<Converter<*, *>>(
                TupleToZonedDateTimeConverter,
                ZonedDateTimeToTupleConverter
            )
        )

    @ReadingConverter
    object TupleToZonedDateTimeConverter: Converter<TupleValue, ZonedDateTime> {
        override fun convert(source: TupleValue): ZonedDateTime {
            val instant = source.getInstant(0)!!
            val zoneId = ZoneId.of(source.getString(1))
            return instant.atZone(zoneId)
        }
    }

    @WritingConverter
    object ZonedDateTimeToTupleConverter: Converter<ZonedDateTime, TupleValue> {
        private val type = DataTypes.tupleOf(DataTypes.TIMESTAMP, DataTypes.TEXT)

        override fun convert(@Nonnull source: ZonedDateTime): TupleValue {
            val tupleValue = type.newValue()
            tupleValue.setInstant(0, source.toInstant())
            tupleValue.setString(1, source.zone.toString())
            return tupleValue
        }
    }

<%_ if (databaseMigrationLiquibase) { _%>

    companion object {
        // CREATE KEYSPACE is a schema change that must reach schema agreement, which does not fit in the driver's 2s default
        // request timeout on a loaded machine.
        private const val KEYSPACE_CREATION_TIMEOUT_SECONDS = 20L
    }
<%_ } _%>
}
