    )<% if (reactive) { %>.block()!!<% } %>

    private val truncateStmt: PreparedStatement = session.prepare("TRUNCATE user")<% if (reactive) { %>.block()!!<% } %>
<%_ if (generateUserManagement) { _%>

    private val truncateByResetKeyStmt: PreparedStatement = session.prepare("TRUNCATE user_by_reset_key")<% if (reactive) { %>.block()!!<% } %>
<%_ } _%>

    private val truncateByLoginStmt: PreparedStatement = session.prepare("TRUNCATE user_by_login")<% if (reactive) { %>.block()!!<% } %>

