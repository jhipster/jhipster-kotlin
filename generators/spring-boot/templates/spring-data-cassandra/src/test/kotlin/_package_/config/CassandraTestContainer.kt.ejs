package <%= packageName %>.config

<%_ if (databaseMigrationLoader) { _%>
import com.datastax.oss.driver.api.core.CqlSession
import com.datastax.oss.driver.api.core.CqlSessionBuilder
import com.datastax.oss.driver.api.core.config.DefaultDriverOption
import com.datastax.oss.driver.api.core.config.DriverConfigLoader
import com.github.dockerjava.api.command.InspectContainerResponse
<%_ } _%>
import org.slf4j.LoggerFactory
import org.springframework.boot.test.context.TestConfiguration
import org.springframework.boot.testcontainers.service.connection.ServiceConnection
import org.springframework.context.annotation.Bean
<%_ if (databaseMigrationLoader) { _%>
import org.springframework.core.io.support.PathMatchingResourcePatternResolver
import org.springframework.data.cassandra.core.cql.session.init.ResourceKeyspacePopulator
<%_ } _%>
import org.springframework.test.context.DynamicPropertyRegistrar
import org.testcontainers.cassandra.CassandraContainer
import org.testcontainers.containers.output.Slf4jLogConsumer
import java.time.Duration
import java.time.temporal.ChronoUnit

@TestConfiguration(proxyBeanMethods = false)
class CassandraTestContainer {

    @Bean
    @ServiceConnection
    fun cassandraContainer(): CassandraContainer = CASSANDRA_CONTAINER

    @Bean
    fun cassandraProperties(cassandraContainer: CassandraContainer): DynamicPropertyRegistrar =
        DynamicPropertyRegistrar { registry -> registry.add("spring.cassandra.keyspace-name") { DEFAULT_KEYSPACE_NAME } }

    companion object {
        const val DEFAULT_KEYSPACE_NAME = "cassandratestkeyspace"

        private val LOG = LoggerFactory.getLogger(CassandraTestContainer::class.java)
<%_ if (databaseMigrationLoader) { _%>
        private const val DATABASE_REQUEST_TIMEOUT_SECONDS = 20L
<%_ } _%>
        private const val CONTAINER_STARTUP_TIMEOUT_MINUTES = 10L

<%_ if (databaseMigrationLiquibase) { _%>
        // The keyspace is created by the application when its session connects and the tables by liquibase.
        private val CASSANDRA_CONTAINER: CassandraContainer = CassandraContainer("<%= dockerContainers.cassandra %>")
<%_ } else { _%>
        // The keyspace must exist before the application's CqlSession connects, so it is created as part of the
        // container startup instead of an eager bean the application context would have to depend on.
        private val CASSANDRA_CONTAINER: CassandraContainer = object : CassandraContainer("<%= dockerContainers.cassandra %>") {
            override fun containerIsStarted(containerInfo: InspectContainerResponse) {
                super.containerIsStarted(containerInfo)
                createKeyspace(this)
            }
        }
<%_ } _%>
            .withStartupTimeout(Duration.of(CONTAINER_STARTUP_TIMEOUT_MINUTES, ChronoUnit.MINUTES))
            .withLogConsumer(Slf4jLogConsumer(LOG))
<%_ if (databaseMigrationLoader) { _%>

        private fun createSession(container: CassandraContainer, keyspace: String? = null): CqlSession {
            val builder = CqlSessionBuilder()
                .addContactPoint(container.contactPoint)
                .withLocalDatacenter(container.localDatacenter)
                // CREATE KEYSPACE is a schema change and must reach schema agreement; the driver's 2s default request
                // timeout is not enough on a loaded CI runner and fails the container startup with a DriverTimeoutException.
                .withConfigLoader(
                    DriverConfigLoader.programmaticBuilder()
                        .withDuration(DefaultDriverOption.REQUEST_TIMEOUT, Duration.ofSeconds(DATABASE_REQUEST_TIMEOUT_SECONDS))
                        .build(),
                )
            keyspace?.let { builder.withKeyspace(it) }
            return builder.build()
        }

        private fun createKeyspace(container: CassandraContainer) {
            createSession(container).use { session ->
                session.execute(
                    "CREATE KEYSPACE IF NOT EXISTS $DEFAULT_KEYSPACE_NAME WITH replication={'class' : 'SimpleStrategy', 'replication_factor':1}",
                )
            }
            createSession(container, DEFAULT_KEYSPACE_NAME).use { session ->
                ResourceKeyspacePopulator(*PathMatchingResourcePatternResolver().getResources("config/cql/changelog/*.cql"))
                    .populate(session)
            }
        }
<%_ } _%>
    }
}
