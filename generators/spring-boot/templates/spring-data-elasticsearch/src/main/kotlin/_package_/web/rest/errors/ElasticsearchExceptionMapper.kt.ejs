package <%= packageName %>.web.rest.errors

import co.elastic.clients.elasticsearch._types.ElasticsearchException
import org.springframework.data.elasticsearch.UncategorizedElasticsearchException

object ElasticsearchExceptionMapper {

    fun mapException(originalException: RuntimeException): RuntimeException {
        var e: Throwable? = originalException
        if (e?.cause is UncategorizedElasticsearchException) {
            e = e.cause
        }
        val cause = e?.cause
        if (cause is ElasticsearchException) {
            val rootCause = cause.response().error().rootCause()
            if (rootCause.isNotEmpty()) {
                val reason = rootCause.first().reason()
                if (reason != null && reason.startsWith("Failed to parse query [")) {
                    return QuerySyntaxException()
                }
            }
        }

        return originalException
    }
}
