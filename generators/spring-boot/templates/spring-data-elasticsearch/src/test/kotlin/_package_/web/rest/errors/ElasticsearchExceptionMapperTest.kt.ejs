package <%= packageName %>.web.rest.errors

import co.elastic.clients.elasticsearch._types.ElasticsearchException
import co.elastic.clients.elasticsearch._types.ErrorCause
import co.elastic.clients.elasticsearch._types.ErrorResponse
import org.junit.jupiter.api.Assertions.assertInstanceOf
import org.junit.jupiter.api.Test
import org.springframework.data.elasticsearch.UncategorizedElasticsearchException

class ElasticsearchExceptionMapperTest {

    @Test
    fun testMapException() {
        val rootCause = ErrorCause.Builder().reason("Failed to parse query [").build()
        val response = ErrorResponse.Builder()
            .error(ErrorCause.Builder().reason("").rootCause(rootCause).build())
            .status(400)
            .build()
        val esException = ElasticsearchException("", response)
        val cause = UncategorizedElasticsearchException("", esException)
        assertInstanceOf(
            QuerySyntaxException::class.java,
            ElasticsearchExceptionMapper.mapException(UncategorizedElasticsearchException("", cause))
        )
    }
}
