package <%= packageName %>.security

import kotlinx.coroutines.reactor.ReactorContext
import kotlinx.coroutines.test.runTest
import org.junit.jupiter.api.Test
import org.springframework.security.authentication.UsernamePasswordAuthenticationToken
import org.springframework.security.core.authority.SimpleGrantedAuthority
import org.springframework.security.core.context.ReactiveSecurityContextHolder
import org.springframework.security.core.context.SecurityContextImpl
import reactor.util.context.Context

<%_ if (authenticationTypeOauth2) { _%>
import java.time.Instant
<%_ } _%>

import org.assertj.core.api.Assertions.assertThat
<%_ if (authenticationTypeOauth2) { _%>
import org.springframework.security.oauth2.core.oidc.endpoint.OidcParameterNames.ID_TOKEN
<%_ } _%>
import kotlin.coroutines.coroutineContext

/**
 * Test class for the {@link SecurityUtils} utility class.
 */
class SecurityUtilsUnitTest {

    private fun securityContext(authentication: org.springframework.security.core.Authentication): Context =
        ReactiveSecurityContextHolder.withAuthentication(authentication)

    private suspend fun <T> withSecurityContext(
        authentication: org.springframework.security.core.Authentication,
        block: suspend () -> T
    ): T {
        val context = securityContext(authentication)
        return kotlinx.coroutines.withContext(
            coroutineContext + ReactorContext(context)
        ) {
            block()
        }
    }

    @Test
    fun testgetCurrentUserLogin() = runTest {
        withSecurityContext(UsernamePasswordAuthenticationToken("admin", "admin")) {
            val login = getCurrentUserLogin()
            assertThat(login).isEqualTo("admin")
        }
    }
    <%_ if (authenticationTypeJwt) { _%>

    @Test
    fun testGetCurrentUserJWT() = runTest {
        withSecurityContext(UsernamePasswordAuthenticationToken("admin", "token")) {
            val jwt = getCurrentUserJWT()
            assertThat(jwt).isEqualTo("token")
        }
    }
    <%_ } _%>

    @Test
    fun testIsAuthenticated() = runTest {
        withSecurityContext(UsernamePasswordAuthenticationToken("admin", "admin")) {
            val result = isAuthenticated()
            assertThat(result).isTrue
        }
    }

    @Test
    fun testAnonymousIsNotAuthenticated() = runTest {
        val authorities = mutableListOf(SimpleGrantedAuthority(ANONYMOUS))
        withSecurityContext(UsernamePasswordAuthenticationToken("admin", "admin", authorities)) {
            val result = isAuthenticated()
            assertThat(result).isFalse
        }
    }

    @Test
    fun testHasCurrentUserAnyOfAuthorities() = runTest {
        val authorities = listOf(SimpleGrantedAuthority(USER))
        val auth = UsernamePasswordAuthenticationToken("admin", "admin", authorities)
        withSecurityContext(auth) {
            var result = hasCurrentUserAnyOfAuthorities(USER, ADMIN)
            assertThat(result).isTrue

            result = hasCurrentUserAnyOfAuthorities(ANONYMOUS, ADMIN)
            assertThat(result).isFalse
        }
    }

    @Test
    fun testHasCurrentUserNoneOfAuthorities() = runTest {
        val authorities = listOf(SimpleGrantedAuthority(USER))
        val auth = UsernamePasswordAuthenticationToken("admin", "admin", authorities)
        withSecurityContext(auth) {
            var result = hasCurrentUserNoneOfAuthorities(USER, ADMIN)
            assertThat(result).isFalse

            result = hasCurrentUserNoneOfAuthorities(ANONYMOUS, ADMIN)
            assertThat(result).isTrue
        }
    }

    @Test
    fun testHasCurrentUserThisAuthority() = runTest {
        val authorities = mutableListOf(SimpleGrantedAuthority(USER))
        val auth = UsernamePasswordAuthenticationToken("admin", "admin", authorities)
        withSecurityContext(auth) {
            var result = hasCurrentUserThisAuthority(USER)
            assertThat(result).isTrue

            result = hasCurrentUserThisAuthority(ADMIN)
            assertThat(result).isFalse
        }
    }
}
