package <%= packageName %>

import <%= packageName %>.<%= mainClass %>
import <%= packageName %>.config.AsyncSyncConfiguration
<%_ if (databaseTypeCouchbase || searchEngineCouchbase) { _%>
import <%= packageName %>.config.CouchbaseTestContainer
import org.springframework.test.context.ActiveProfiles
import tech.jhipster.config.JHipsterConstants
<%_ } _%>
<%_ if (databaseTypeMongodb) { _%>
import <%= packageName %>.config.MongoDbTestContainer
<%_ } _%>
<%_ if (databaseTypeCassandra) { _%>
import <%= packageName %>.config.CassandraTestContainer
<%_ } _%>
<%_ if (searchEngineElasticsearch) { _%>
import <%= packageName %>.config.ElasticsearchTestConfiguration
import <%= packageName %>.config.ElasticsearchTestContainer
<%_ } _%>
<%_ if (databaseTypeNeo4j) { _%>
import <%= packageName %>.config.Neo4jTestContainer
<%_ } _%>
<%_ if (databaseTypeSql && !reactive) { _%>
import <%= packageName %>.config.JacksonHibernateConfiguration
<%_ } _%>
<%_ if (databaseTypeSql) { _%>
  <%_ if (locals.implementsDynamicSourceTestcontainersSupport) { _%>
import <%= packageName %>.config.DatabaseTestcontainer
  <%_ } else { _%>
import <%= packageName %>.config.EmbeddedSQL
  <%_ } _%>
<%_ } _%>
<%_ if (cacheProviderRedis) { _%>
import <%= packageName %>.config.RedisTestContainer
<%_ } _%>
<%_ if (authenticationTypeOauth2) { _%>
import <%= packageName %>.config.TestSecurityConfiguration
<%_ } _%>

import org.springframework.boot.test.context.SpringBootTest
<%_
const testConfigurations = [`${mainClass}::class`, 'AsyncSyncConfiguration::class'];
if (authenticationTypeOauth2) testConfigurations.push('TestSecurityConfiguration::class');
if (cacheProviderRedis) testConfigurations.push('RedisTestContainer::class');
if (databaseTypeCouchbase || searchEngineCouchbase) testConfigurations.push('CouchbaseTestContainer::class');
if (databaseTypeCassandra) testConfigurations.push('CassandraTestContainer::class');
if (databaseTypeNeo4j) testConfigurations.push('Neo4jTestContainer::class');
if (databaseTypeMongodb) testConfigurations.push('MongoDbTestContainer::class');
if (databaseTypeSql && locals.implementsDynamicSourceTestcontainersSupport) testConfigurations.push('DatabaseTestcontainer::class');
if (databaseTypeSql && !reactive) testConfigurations.push('JacksonHibernateConfiguration::class');
if (searchEngineElasticsearch) testConfigurations.push('ElasticsearchTestContainer::class', 'ElasticsearchTestConfiguration::class');
_%>

/**
 * Base composite annotation for integration tests.
 */
@kotlin.annotation.Target(AnnotationTarget.CLASS)
@kotlin.annotation.Retention(AnnotationRetention.RUNTIME)
@SpringBootTest(classes = [<%- testConfigurations.join(', ') %>])
<%_ if (databaseTypeCouchbase || searchEngineCouchbase) { _%>
@ActiveProfiles(JHipsterConstants.SPRING_PROFILE_TEST)
<%_ } _%>
<%_ if (databaseTypeSql && !locals.implementsDynamicSourceTestcontainersSupport) { _%>
@EmbeddedSQL
<%_ } _%>
annotation class IntegrationTest {
     <%_ if (reactive) { _%>
      companion object {
        // 5s is the spring default https://github.com/spring-projects/spring-framework/blob/29185a3d28fa5e9c1b4821ffe519ef6f56b51962/spring-test/src/main/java/org/springframework/test/web/reactive/server/DefaultWebTestClient.java#L106
          const val DEFAULT_TIMEOUT: String = "PT5S"
          const val DEFAULT_ENTITY_TIMEOUT: String = "PT5S"
      }
     <%_ } _%>
}
