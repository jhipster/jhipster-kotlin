package <%- packageName %>.config

import ch.qos.logback.classic.spi.ILoggingEvent
import org.assertj.core.api.Assertions.assertThat
import org.junit.jupiter.api.Assertions.assertEquals
import org.junit.jupiter.api.Assertions.assertFalse
import org.junit.jupiter.api.Assertions.assertTrue
import org.junit.jupiter.api.Test
import org.slf4j.Marker
import org.slf4j.MarkerFactory
import org.springframework.boot.ansi.AnsiColor
import org.springframework.boot.ansi.AnsiElement
import org.mockito.Mockito.mock
import org.mockito.Mockito.`when`

class CRLFLogConverterTest {

    @Test
    fun transformShouldReturnInputStringWhenMarkerListIsEmpty() {
        val event = mock(ILoggingEvent::class.java)
        `when`(event.markerList).thenReturn(null)
        `when`(event.loggerName).thenReturn("org.hibernate.example.Logger")
        val input = "Test input string"
        val converter = CRLFLogConverter()

        val result = converter.transform(event, input)

        assertEquals(input, result)
    }

    @Test
    fun transformShouldReturnInputStringWhenMarkersContainCRLFSafeMarker() {
        val event = mock(ILoggingEvent::class.java)
        val marker: Marker = MarkerFactory.getMarker("CRLF_SAFE")
        val markers = listOf(marker)
        `when`(event.markerList).thenReturn(markers)
        val input = "Test input string"
        val converter = CRLFLogConverter()

        val result = converter.transform(event, input)

        assertEquals(input, result)
    }

    @Test
    fun transformShouldReturnInputStringWhenMarkersNotContainCRLFSafeMarker() {
        val event = mock(ILoggingEvent::class.java)
        val marker: Marker = MarkerFactory.getMarker("CRLF_NOT_SAFE")
        val markers = listOf(marker)
        `when`(event.markerList).thenReturn(markers)
        `when`(event.loggerName).thenReturn("org.hibernate.example.Logger")
        val input = "Test input string"
        val converter = CRLFLogConverter()

        val result = converter.transform(event, input)

        assertEquals(input, result)
    }

    @Test
    fun transformShouldReturnInputStringWhenLoggerIsSafe() {
        val event = mock(ILoggingEvent::class.java)
        `when`(event.loggerName).thenReturn("org.hibernate.example.Logger")
        val input = "Test input string"
        val converter = CRLFLogConverter()

        val result = converter.transform(event, input)

        assertEquals(input, result)
    }

    @Test
    fun transformShouldReplaceNewlinesAndCarriageReturnsWithUnderscoreWhenMarkersDoNotContainCRLFSafeMarkerAndLoggerIsNotSafe() {
        val event = mock(ILoggingEvent::class.java)
        val markers = emptyList<Marker>()
        `when`(event.markerList).thenReturn(markers)
        `when`(event.loggerName).thenReturn("<%- packageName %>.example.Logger")
        val input = "Test\ninput\rstring"
        val converter = CRLFLogConverter()

        val result = converter.transform(event, input)

        assertEquals("Test_input_string", result)
    }

    @Test
    fun transformShouldSanitizeUnsafeLoggerWithAnsi() {
        val event = mock(ILoggingEvent::class.java)
        val markers = emptyList<Marker>()
        `when`(event.markerList).thenReturn(markers)
        `when`(event.loggerName).thenReturn("<%- packageName %>.example.Logger")
        val input = "Test\ninput\rstring"
        val converter = CRLFLogConverter()
        converter.setOptionList(listOf("red"))

        val result = converter.transform(event, input)

        assertEquals("Test_input_string", result)
    }

    @Test
    fun isLoggerSafeShouldReturnTrueWhenLoggerNameStartsWithSafeLogger() {
        val event = mock(ILoggingEvent::class.java)
        `when`(event.loggerName).thenReturn("org.springframework.boot.autoconfigure.example.Logger")
        val converter = CRLFLogConverter()

        val result = converter.isLoggerSafe(event)

        assertTrue(result)
    }

    @Test
    fun isLoggerSafeShouldReturnFalseWhenLoggerNameDoesNotStartWithSafeLogger() {
        val event = mock(ILoggingEvent::class.java)
        `when`(event.loggerName).thenReturn("<%- packageName %>.example.Logger")
        val converter = CRLFLogConverter()

        val result = converter.isLoggerSafe(event)

        assertFalse(result)
    }

    @Test
    fun testToAnsiString() {
        val cut = CRLFLogConverter()
        val ansiElement: AnsiElement = AnsiColor.RED

        val result = cut.toAnsiString("input", ansiElement)

        assertThat(result).isEqualTo("input")
    }
}
