package <%= entityAbsolutePackage %>.service.dto

import java.util.Objects
<%_ if (entityApiDescription || restProperties.some(property => property.propertyApiDescription) || importApiModelProperty) { _%>
import io.swagger.v3.oas.annotations.media.Schema
<%_ } _%>
<%_ if (anyFieldIsInstant) { _%>
import java.time.Instant
<%_ } _%>
<%_ if (anyFieldIsLocalDate) { _%>
import java.time.LocalDate
<%_ } _%>
<%_ if (anyFieldIsLocalTime) { _%>
import java.time.LocalTime
<%_ } _%>
<%_ if (anyFieldIsZonedDateTime) { _%>
import java.time.ZonedDateTime
<%_ } _%>
<%_ if (anyFieldIsDuration) { _%>
import java.time.Duration
<%_ } _%>
<%_ if (anyPropertyHasValidation) { _%>
import jakarta.validation.constraints.*
<%_ } _%>
import java.io.Serializable
<%_ if (anyFieldIsBigDecimal) { _%>
import java.math.BigDecimal
<%_ } _%>
<%_ if (anyFieldIsBlobDerived && databaseTypeCassandra) { _%>
import java.nio.ByteBuffer
<%_ } _%>
<%_ if (anyFieldIsUUID) { _%>
import java.util.UUID
<%_ } _%>
<%_ if (anyFieldIsBlobDerived && databaseTypeSql) { _%>
import jakarta.persistence.Lob
<%_ } _%>
<%_ for (const enumField of uniqueEnums) { _%>
import <%= entityAbsolutePackage %>.domain.enumeration.<%= enumField.fieldType %>
<%_ } _%>

<%_ for (const otherEntity of otherEntities.filter(otherEntity => otherEntity.entityPackage !== entityPackage)) { _%>
import <%= `${otherEntity.entityAbsolutePackage}.service.dto.${otherEntity.dtoClass}` %>
<%_ } _%>

/**
 * A DTO for the [<%= entityAbsolutePackage %>.domain.<%= persistClass %>] entity.
 */
<%_ if (entityApiDescription) { _%>
@Schema(description = "<%- entityApiDescription %>")
<%_ } _%>
@SuppressWarnings("common-java:DuplicatedBlocks")
data class <%= dtoClass %>(
<%_
    const entityClassProperties = [];
    for (const property of restProperties) {
        const classProperty = [];
        if (property.propertyJavadoc) {
            classProperty.push(property.propertyJavadoc.trim());
        }
        const field = property.fieldName ? property : undefined;
        const relationship = property.relationshipName ? property : undefined;
        const required = field && field.fieldValidate && field.fieldValidationRequired;

        if (field && field.fieldValidate) {
            const validators = include('/_global_partials_entity_/field_validators', { field, reactive }).trim();
            if (validators) {
                classProperty.push(validators);
            }
        }
        if (relationship && relationship.relationshipRequired) {
            classProperty.push('@get: NotNull');
        }
        if (property.propertyApiDescription) {
            classProperty.push(`@Schema(description = "${property.propertyApiDescription}"${required ? ', requiredMode = Schema.RequiredMode.REQUIRED' : ''})`);
        }
        if (property.fieldTypeBytes && databaseTypeSql) {
            classProperty.push('@Lob');
        }

        let propertyDef = '';
        if (field) {
            let kotlinType = field.fieldType;
            if (field.fieldTypeBlobContent === 'text') {
                kotlinType = 'String';
            } else if (field.fieldTypeBytes || field.fieldType === 'byte[]') {
                kotlinType = 'ByteArray';
            } else if (field.fieldType === 'Integer') {
                kotlinType = 'Int';
            }
            propertyDef = `var ${field.propertyName}: ${kotlinType}? = null`;
            if (field.fieldWithContentType) {
                propertyDef += `,\n    var ${field.propertyName}ContentType: String? = null`;
            }
        } else if (relationship) {
            if (relationship.collection) {
                propertyDef = `var ${relationship.propertyName}: MutableSet<${relationship.otherEntity.dtoClass}> = mutableSetOf()`;
            } else {
                propertyDef = `var ${relationship.propertyName}: ${relationship.otherEntity.dtoClass}? = null`;
            }
        }

        classProperty.push(propertyDef);
        entityClassProperties.push(classProperty.join('\n    '));
    }
_%>
    <%- entityClassProperties.join(',\n\n    ') %>
) : Serializable {

    <%_ const idNames = primaryKey ? [...primaryKey.fields.map(f => f.propertyName)] : []; _%>

    override fun equals(other: Any?): Boolean {
        if (this === other) return true
        if (other !is <%= dtoClass %>) return false
        <%_ if (embedded) { _%>
        return false
        <%_ } else { _%>
        val <%= dtoInstance %> = other
        if (<%- idNames.map(n => `this.${n} == null`).join(' && ') %>) {
            return false
        }
        return <%- idNames.map(n => `Objects.equals(this.${n}, ${dtoInstance}.${n})`).join(' &&\n            ') %>
        <%_ } _%>
    }

    override fun hashCode(): Int = <%_ if (embedded) { _%>
        javaClass.hashCode()
    <%_ } else { _%>
        Objects.hash(<%- idNames.map(n => `this.${n}`).join(', ') %>)
    <%_ } _%>
}
