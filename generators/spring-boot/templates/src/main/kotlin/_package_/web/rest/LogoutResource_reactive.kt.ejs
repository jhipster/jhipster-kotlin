package <%= packageName %>.web.rest

import org.springframework.http.server.reactive.ServerHttpRequest
import org.springframework.security.core.annotation.AuthenticationPrincipal
import org.springframework.security.core.annotation.CurrentSecurityContext
import org.springframework.security.oauth2.client.authentication.OAuth2AuthenticationToken
import org.springframework.security.oauth2.client.registration.ClientRegistration
import org.springframework.security.oauth2.client.registration.ReactiveClientRegistrationRepository
import org.springframework.security.oauth2.core.oidc.OidcIdToken
import org.springframework.security.oauth2.core.oidc.user.OidcUser
import org.springframework.web.bind.annotation.PostMapping
import org.springframework.web.bind.annotation.RestController
import org.springframework.web.server.WebSession
import kotlinx.coroutines.reactor.awaitSingle
import kotlinx.coroutines.reactor.awaitSingleOrNull

/**
 * REST controller for managing global OIDC logout.
 */
@RestController
class LogoutResource(private val registrationRepository: ReactiveClientRegistrationRepository) {

    /**
     * `POST  /api/logout` : logout the current user.
     *
     * @param oAuth2AuthenticationToken the OAuth2 authentication token.
     * @param oidcUser the OIDC user.
     * @param request a [ServerHttpRequest] request.
     * @param session the current [WebSession].
     * @return status `200 (OK)` and a body with a global logout URL.
     */
    @PostMapping("/api/logout")
    suspend fun logout(
        @CurrentSecurityContext(expression = "authentication") oAuth2AuthenticationToken: OAuth2AuthenticationToken,
        @AuthenticationPrincipal oidcUser: OidcUser,
        request: ServerHttpRequest,
        session: WebSession,
    ): Map<String, String> {
        session.invalidate().awaitSingleOrNull()
        val oidc = registrationRepository
            .findByRegistrationId(oAuth2AuthenticationToken.authorizedClientRegistrationId)
            .awaitSingle()
        return prepareLogoutUri(request, oidc, oidcUser.idToken)
    }

    private fun prepareLogoutUri(request: ServerHttpRequest, clientRegistration: ClientRegistration, idToken: OidcIdToken): Map<String, String> {
        val logoutUrl = StringBuilder()
            .append(clientRegistration.providerDetails.configurationMetadata["end_session_endpoint"].toString())

        val originUrl = request.headers.origin ?: request.uri.let { "${it.scheme}://${it.authority}" }

        logoutUrl.append("?id_token_hint=").append(idToken.tokenValue).append("&post_logout_redirect_uri=").append(originUrl)

        return mapOf("logoutUrl" to logoutUrl.toString())
    }
}
