/**
 * Controller advice to translate the server side exceptions to client-friendly json structures.
 * The error response follows RFC7807 - Problem Details for HTTP APIs (https://tools.ietf.org/html/rfc7807).
 */
@ControllerAdvice
<%_ if (databaseTypeSql && reactive) { _%>
@Component("jhiExceptionTranslator")
<%_ } _%>
class ExceptionTranslator(private val env: Environment) : ResponseEntityExceptionHandler()<% if (reactive) { %>, ExceptionTranslation<% } %> {

    private val log = LoggerFactory.getLogger(javaClass)

    @Value("\${jhipster.clientApp.name:<%= camelizedBaseName %>}")
    private val applicationName: String? = null

    @ExceptionHandler
    <%_ if (reactive) { _%>
    override fun handleAnyException(ex: Throwable, request: <%= requestClass %>): <%- returnType %> {
    <%_ } else { _%>
    fun handleAnyException(ex: Throwable, request: <%= requestClass %>): <%- returnType %> {
    <%_ } _%>
        log.debug("Converting Exception to Problem Details:", ex)
        val pdCause = wrapAndCustomizeProblem(ex, request)
        return handleExceptionInternal(ex as Exception, pdCause, buildHeaders(ex)<% if (!reactive) { %> ?: HttpHeaders()<% } %>, HttpStatusCode.valueOf(pdCause.status), request)
    }

    override fun handleExceptionInternal(
        ex: Exception,
        body: Any?,
        headers: HttpHeaders<% if (reactive) { %>?<% } %>,
        statusCode: HttpStatusCode,
        request: <%= requestEntityRequestClass %>
    ): <%- returnType %> {
        val problemBody = body ?: wrapAndCustomizeProblem(ex, request<% if (!reactive) { %> as NativeWebRequest<% } %>)
<%_ if (reactive) { _%>
        if (request.response.isCommitted) {
            return Mono.error(ex)
        }
        return Mono.just(
            ResponseEntity(problemBody, updateContentType(headers), HttpStatusCode.valueOf((problemBody as ProblemDetailWithCause).status))
        )
<%_ } else { _%>
        return super.handleExceptionInternal(ex, problemBody, headers, statusCode, request)
<%_ } _%>
    }

    protected fun wrapAndCustomizeProblem(ex: Throwable, request: <%= requestClass %>?): ProblemDetailWithCause =
        customizeProblem(getProblemDetailWithCause(ex), ex, request)

    private fun getProblemDetailWithCause(ex: Throwable): ProblemDetailWithCause {
<%_ if (!skipUserManagement) { _%>
        if (ex is <%= packageName %>.service.UsernameAlreadyUsedException) {
            return LoginAlreadyUsedException().body as ProblemDetailWithCause
        }
        if (ex is <%= packageName %>.service.EmailAlreadyUsedException) {
            return EmailAlreadyUsedException().body as ProblemDetailWithCause
        }
        if (ex is <%= packageName %>.service.InvalidPasswordException) {
            return InvalidPasswordException().body as ProblemDetailWithCause
        }
  <%_ if (reactive) { _%>
        if (ex is AuthenticationException) {
            // Ensure no information about existing users is revealed via failed authentication attempts
            return ProblemDetailWithCauseBuilder.instance()
                .withStatus(toStatus(ex).value())
                .withTitle("Unauthorized")
                .withDetail("Invalid credentials")
                .build()
        }
  <%_ } _%>
<%_ } _%>
        if (ex is ErrorResponseException) {
            val body = ex.body
            if (body is ProblemDetailWithCause) return body
        }
        return ProblemDetailWithCauseBuilder.instance().withStatus(toStatus(ex).value()).build()
    }

    protected fun customizeProblem(problem: ProblemDetailWithCause, err: Throwable, request: <%= requestClass %>?): ProblemDetailWithCause {
        if (problem.status <= 0) problem.setStatus(toStatus(err))

        if (problem.type == URI.create("about:blank")) problem.type = getMappedType(err)

        // higher precedence to Custom/ResponseStatus types
        val title = extractTitle(err, problem.status)
        if (problem.title == null || problem.title != title) {
            problem.title = title
        }

        if (problem.detail == null) {
            // higher precedence to cause
            problem.detail = getCustomizedErrorDetails(err)
        }

        val problemProperties = problem.properties
        if (problemProperties == null || !problemProperties.containsKey(MESSAGE_KEY)) {
            problem.setProperty(MESSAGE_KEY, getMappedMessageKey(err) ?: "error.http.${problem.status}")
        }

        if (problemProperties == null || !problemProperties.containsKey(PATH_KEY)) {
            problem.setProperty(PATH_KEY, getPathValue(request))
        }

        if (err is <%= bindException %> && (problemProperties == null || !problemProperties.containsKey(FIELD_ERRORS_KEY))) {
            problem.setProperty(FIELD_ERRORS_KEY, getFieldErrors(err))
        }

        problem.cause = buildCause(err.cause, request)

        return problem
    }

    private fun extractTitle(err: Throwable, statusCode: Int): String? =
        getCustomizedTitle(err) ?: extractTitleForResponseStatus(err, statusCode)

    private fun getFieldErrors(ex: <%= bindException %>): List<FieldErrorVM> =
        ex.bindingResult.fieldErrors.map {
            FieldErrorVM(
                it.objectName.replaceFirst(Regex("<%= dtoSuffix %>$"), ""),
                it.field,
                if (StringUtils.isNotBlank(it.defaultMessage)) it.defaultMessage else it.code
            )
        }

    private fun extractTitleForResponseStatus(err: Throwable, statusCode: Int): String? {
        val specialStatus = extractResponseStatus(err)
        return specialStatus?.reason ?: HttpStatus.valueOf(statusCode).reasonPhrase
    }

<%_ if (!reactive) { _%>
    private fun extractURI(request: <%= requestClass %>): String {
        val nativeRequest = request.getNativeRequest(HttpServletRequest::class.java)
        return nativeRequest?.requestURI ?: StringUtils.EMPTY
    }

<%_ } _%>
    private fun toStatus(throwable: Throwable): HttpStatus {
        // Let the ErrorResponse take this responsibility
        if (throwable is ErrorResponse) return HttpStatus.valueOf(throwable.body.status)

        return getMappedStatus(throwable) ?: resolveResponseStatus(throwable)?.value ?: HttpStatus.INTERNAL_SERVER_ERROR
    }

    private fun extractResponseStatus(throwable: Throwable): ResponseStatus? = resolveResponseStatus(throwable)

    private fun resolveResponseStatus(type: Throwable): ResponseStatus? {
        val candidate = findMergedAnnotation(type.javaClass, ResponseStatus::class.java)
        val cause = type.cause
        return if (candidate == null && cause != null) resolveResponseStatus(cause) else candidate
    }

    private fun getMappedType(err: Throwable): URI =
        if (err is MethodArgumentNotValidException || err is ConstraintViolationException) CONSTRAINT_VIOLATION_TYPE else DEFAULT_TYPE

    private fun getMappedMessageKey(err: Throwable): String? =
        when {
            err is MethodArgumentNotValidException || err is ConstraintViolationException -> ERR_VALIDATION
<%_ if (!databaseTypeNo && !databaseTypeCassandra) { _%>
            err is ConcurrencyFailureException || err.cause is ConcurrencyFailureException -> ERR_CONCURRENCY_FAILURE
<%_ } _%>
<%_ if (reactive) { _%>
            err is WebExchangeBindException -> ERR_VALIDATION
<%_ } _%>
            else -> null
        }

    private fun getCustomizedTitle(err: Throwable): String? =
        if (err is MethodArgumentNotValidException || err is ConstraintViolationException) "Method argument not valid" else null

    private fun getCustomizedErrorDetails(err: Throwable): String? {
        val activeProfiles = env.activeProfiles.toList()
        if (activeProfiles.contains(JHipsterConstants.SPRING_PROFILE_PRODUCTION)) {
            if (err is HttpMessageConversionException) return "Unable to convert http message"
<%_ if (!databaseTypeNo) { _%>
            if (err is DataAccessException) return "Failure during data access"
<%_ } _%>
            if (containsPackageName(err.message)) return "Unexpected runtime exception"
        }
        return err.cause?.message ?: err.message
    }

    private fun getMappedStatus(err: Throwable): HttpStatus? =
        when (err) {
            // Where we disagree with Spring defaults
            is AccessDeniedException -> HttpStatus.FORBIDDEN
<%_ if (!databaseTypeNo && !databaseTypeCassandra) { _%>
            is ConcurrencyFailureException -> HttpStatus.CONFLICT
<%_ } _%>
            is BadCredentialsException -> HttpStatus.UNAUTHORIZED
<%_ if (reactive) { _%>
            is UsernameNotFoundException -> HttpStatus.UNAUTHORIZED
<%_ } _%>
            is ConstraintViolationException -> HttpStatus.BAD_REQUEST
            else -> null
        }

    private fun getPathValue(request: <%= requestClass %>?): URI {
        if (request == null) return URI.create("about:blank")
        return <% if (reactive) { %>request.request.uri<% } else { %>URI.create(extractURI(request))<% } %>
    }

    private fun buildHeaders(err: Throwable): HttpHeaders? =
        if (err is BadRequestAlertException) {
            HeaderUtil.createFailureAlert(applicationName, <%= enableTranslation %>, err.entityName, err.errorKey, err.message)
        } else {
            null
        }
<%_ if (reactive) { _%>

    private fun updateContentType(headers: HttpHeaders?): HttpHeaders {
        if (headers == null) {
            val newHeaders = HttpHeaders()
            newHeaders.contentType = MediaType.APPLICATION_PROBLEM_JSON
            return newHeaders
        }
        return headers
    }
<%_ } _%>

    fun buildCause(throwable: Throwable?, request: <%= requestClass %>?): ProblemDetailWithCause? {
        if (throwable != null && isCausalChainEnabled()) {
            return customizeProblem(getProblemDetailWithCause(throwable), throwable, request)
        }
        return null
    }

    private fun isCausalChainEnabled(): Boolean {
        // Customize as per the needs
        return CAUSAL_CHAIN_ENABLED
    }

    private fun containsPackageName(message: String?): Boolean =
        // This list is for sure not complete
        Strings.CS.containsAny(message, "org.", "java.", "net.", "jakarta.", "javax.", "com.", "io.", "de.", "<%= packageName %>")
}
