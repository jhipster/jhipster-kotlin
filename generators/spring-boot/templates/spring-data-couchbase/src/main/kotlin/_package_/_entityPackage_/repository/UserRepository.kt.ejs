package <%- packageName %>.repository

import <%- user.entityAbsoluteClass %>

<%_ if (cacheProviderAny) { _%>
import org.springframework.cache.annotation.Cacheable
<%_ } _%>
import org.springframework.data.domain.*
import org.springframework.data.couchbase.repository.Query
import org.springframework.stereotype.Repository
<%_ if (reactive) { _%>
import reactor.core.publisher.Flux
import reactor.core.publisher.Mono
<%_ } else { _%>
import java.util.List
import java.util.Optional
<%_ } _%>
<%_ if (user.primaryKey.hasUUID) { _%>
import java.util.UUID
<%_ } _%>
<%_ if (!authenticationTypeOauth2) { _%>
import java.time.Instant
<%_ } _%>

/**
 * <%- springDataDescription %> repository for the {@link <%- user.persistClass %>} entity.
 */
<%_
    let optionalOrMono = reactive ? 'Mono' : 'Optional';
    let listOrFlux = reactive ? 'Flux' : 'MutableList';
    let pageOrFlux = reactive ? 'Flux' : 'Page';
_%>
@Repository
interface UserRepository : JHipsterCouchbaseRepository<<%- user.persistClass %>, String><% if (searchEngineCouchbase) { %>, CouchbaseSearchRepository<<%- user.persistClass %>, String><% } %> {
<%_ if (cacheProviderAny) { _%>

    companion object {
        const val USERS_BY_LOGIN_CACHE: String = "usersByLogin"
        const val USERS_BY_EMAIL_CACHE: String = "usersByEmail"
    }
<%_ } _%>
<%_ if (!authenticationTypeOauth2) { _%>

    fun findOneByActivationKey(activationKey: String): <%- optionalOrMono %><<%- user.persistClass %>> {
        return findIdByActivationKey(activationKey)
            .map { it.id }
            .flatMap(this::findById)
    }

    @Query(FIND_IDS_QUERY + " AND activationKey = $1")
    fun findIdByActivationKey(activationKey: String): <%- optionalOrMono %><<%- user.persistClass %>>

    fun findAllByActivatedIsFalseAndActivationKeyIsNotNullAndCreatedDateBefore(dateTime: Instant): <%- listOrFlux %><<%- user.persistClass %>> {
        return findAllById(toIds(findAllIdsByActivatedIsFalseAndActivationKeyIsNotNullAndCreatedDateBefore(dateTime)<%- reactive ? '' : '.toMutableList()' %>))
    }

    @Query(FIND_IDS_QUERY + " AND activated = false AND activationKey IS NOT NULL AND createdDate < $1")
    fun findAllIdsByActivatedIsFalseAndActivationKeyIsNotNullAndCreatedDateBefore(dateTime: Instant): <%- listOrFlux %><<%- user.persistClass %>>

    fun findOneByResetKey(resetKey: String): <%- optionalOrMono %><<%- user.persistClass %>> {
        return findIdByResetKey(resetKey)
            .map { it.id }
            .flatMap(this::findById)
    }

    @Query(FIND_IDS_QUERY + " AND resetKey = $1")
    fun findIdByResetKey(resetKey: String): <%- optionalOrMono %><<%- user.persistClass %>>
<%_ if (cacheProviderAny) { _%>

    @Cacheable(cacheNames = [USERS_BY_EMAIL_CACHE], unless = "#result == null")
<%_ } _%>
    fun findOneByEmailIgnoreCase(email: String): <%- optionalOrMono %><<%- user.persistClass %>> {
        return findIdByEmailIgnoreCase(email)
            .map { it.id }
            .flatMap(this::findById)
    }

    @Query(FIND_IDS_QUERY + " AND LOWER(email) = LOWER($1)")
    fun findIdByEmailIgnoreCase(email: String): <%- optionalOrMono %><<%- user.persistClass %>>
<%_ } _%>
<%_ if (cacheProviderAny) { _%>

    @Cacheable(cacheNames = [USERS_BY_LOGIN_CACHE], unless = "#result == null")
<%_ } _%>
    fun findOneByLogin(login: String): <%- optionalOrMono %><<%- user.persistClass %>> {
        return findById(login)
    }

    fun findAllByActivatedIsTrue(pageable: Pageable): <%- pageOrFlux %><<%- user.persistClass %>> {
<%_ if (reactive) { _%>
        return findAllById(toIds(findAllIdsByActivatedIsTrue(pageable)))
<%_ } else { _%>
        val page = findAllIdsByActivatedIsTrue(pageable)
        return PageImpl(findAllById(toIds(page.content.toMutableList())), pageable, page.totalElements)
<%_ } _%>
    }

    @Query(FIND_IDS_QUERY + " AND activated = true")
    fun findAllIdsByActivatedIsTrue(pageable: Pageable): <%- pageOrFlux %><<%- user.persistClass %>>
<%_ if (reactive) { _%>

    override fun count(): Mono<Long>
<%_ } _%>
}
