package <%= packageName %>.config

<%_ if (databaseTypeSql) { _%>
import tech.jhipster.config.JHipsterConstants
<%_ } _%>
import org.slf4j.LoggerFactory
import org.springframework.boot.test.util.TestPropertyValues
import org.springframework.context.ConfigurableApplicationContext
import org.springframework.core.annotation.AnnotatedElementUtils
import org.springframework.test.context.ContextConfigurationAttributes
import org.springframework.test.context.ContextCustomizer
import org.springframework.test.context.ContextCustomizerFactory
import org.springframework.test.context.MergedContextConfiguration

class SqlTestContainersSpringContextCustomizerFactory : ContextCustomizerFactory {

    private val log = LoggerFactory.getLogger(SqlTestContainersSpringContextCustomizerFactory::class.java)

    override fun createContextCustomizer(
        testClass: Class<*>,
        configAttributes: List<ContextConfigurationAttributes>,
    ): ContextCustomizer = object : ContextCustomizer {
        override fun customizeContext(context: ConfigurableApplicationContext, mergedConfig: MergedContextConfiguration) {
            val beanFactory = context.beanFactory
            var testValues = TestPropertyValues.empty()
            val sqlAnnotation = AnnotatedElementUtils.findMergedAnnotation(testClass, EmbeddedSQL::class.java)
<%_ if (prodDatabaseType === devDatabaseType) { _%>
            if (sqlAnnotation != null) {
<%_ } else { _%>
            val usingTestProdProfile = context.environment.activeProfiles.contains("test${JHipsterConstants.SPRING_PROFILE_PRODUCTION}")
            if (sqlAnnotation != null && usingTestProdProfile) {
<%_ } _%>
                log.debug("detected the EmbeddedSQL annotation on class {}", testClass.name)
                log.info("Warming up the sql database")
                if (prodTestContainer == null) {
                    try {
                        val containerClass = Class.forName("${javaClass.packageName}.DatabaseTestcontainer").asSubclass(SqlTestContainer::class.java)
                        prodTestContainer = beanFactory.createBean(containerClass)
                        beanFactory.registerSingleton(containerClass.name, prodTestContainer)
                    } catch (exception: ClassNotFoundException) {
                        throw RuntimeException(exception)
                    }
                }
                prodTestContainer?.testContainer?.let { container ->
<%_ if (reactive) { _%>
                    testValues = testValues.and("spring.r2dbc.url=" + container.jdbcUrl.replace("jdbc", "r2dbc")<%- prodDatabaseTypeMssql ? '.replace(";encrypt=false", "")' : '' %> + "<%- prodDatabaseExtraOptions %>")
                    testValues = testValues.and("spring.r2dbc.username=" + container.username)
                    testValues = testValues.and("spring.r2dbc.password=" + container.password)
                    testValues = testValues.and("spring.liquibase.url=" + container.jdbcUrl + "<%- prodDatabaseExtraOptions %>")
<%_ } else { _%>
                    testValues = testValues.and("spring.datasource.url=" + container.jdbcUrl + "<%- prodDatabaseExtraOptions %>")
                    testValues = testValues.and("spring.datasource.username=" + container.username)
                    testValues = testValues.and("spring.datasource.password=" + container.password)
<%_ } _%>
                }
            }
            testValues.applyTo(context)
        }

        override fun hashCode() = SqlTestContainer::class.java.name.hashCode()

        override fun equals(other: Any?) = other != null && hashCode() == other.hashCode()
    }

    companion object {
        private var prodTestContainer: SqlTestContainer? = null
    }
}
