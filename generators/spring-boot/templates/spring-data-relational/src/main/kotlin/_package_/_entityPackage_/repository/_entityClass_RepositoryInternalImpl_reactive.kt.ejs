<%_ const toOneRelationships = relationships.filter(rel => rel.ownerSide && !rel.collection);
    const eagerToOneRelationships = toOneRelationships.filter(rel => rel.relationshipEagerLoad);
    const referencedRelationships = toOneRelationships.filter(rel => !rel.relationshipEagerLoad);
    const joinTableRelationships = relationships.filter(rel => rel.shouldWriteJoinTable);
    const eagerJoinTableRelationships = joinTableRelationships.filter(rel => rel.relationshipEagerLoad);
    const populateRelations = toOneRelationships.length > 0 || eagerJoinTableRelationships.length > 0;
    const populateCount = eagerToOneRelationships.length + eagerJoinTableRelationships.length;
    const joinTableConstant = rel => `${rel.relationshipName.replace(/[A-Z]/g, letter => `_${letter}`).toUpperCase()}_JOIN_TABLE`;
    const ownDomainImport = `${entityAbsolutePackage}.domain.${persistClass}`;
    const otherDomainImports = [...new Set([...toOneRelationships, ...joinTableRelationships]
      .map(rel => `${rel.otherEntity.entityAbsolutePackage}.domain.${rel.otherEntity.persistClass}`)
      .filter(domainImport => domainImport !== ownDomainImport))].sort();
_%>
package <%= entityAbsolutePackage %>.repository

<%_ if (jpaMetamodelFiltering) { _%>
import org.springframework.data.domain.Pageable
<%_ } _%>
import org.springframework.data.r2dbc.convert.R2dbcConverter
import org.springframework.data.r2dbc.core.R2dbcEntityTemplate
import org.springframework.data.r2dbc.dialect.R2dbcDialect
<%_ if (jpaMetamodelFiltering) { _%>
import org.springframework.data.relational.core.query.Criteria
<%_ } _%>

import <%= entityAbsolutePackage %>.domain.<%= persistClass %>
<%_ if (jpaMetamodelFiltering) { _%>
import <%= entityAbsolutePackage %>.domain.criteria.<%= entityClass %>Criteria
<%_ } _%>
<%_ for (const domainImport of otherDomainImports) { _%>
import <%= domainImport %>
<%_ } _%>
<%_ if (packageName !== entityAbsolutePackage) { _%>
import <%= packageName %>.repository.AbstractR2dbcRepository
<%_ } _%>
<%_ if (jpaMetamodelFiltering) { _%>

import reactor.core.publisher.Flux
import tech.jhipster.service.CriteriaBuilder
<%_ } _%>
<%_ if (populateRelations || isUsingMapsId || jpaMetamodelFiltering) { _%>
import reactor.core.publisher.Mono
<%_ } _%>
<%_ if (primaryKey.typeUUID) { _%>

import java.util.UUID
<%_ } _%>

/**
 * <%= springDataDescription %> custom repository implementation for the <%= persistClass %> entity.
 */
@Suppress("unused")
class <%= entityClass %>RepositoryInternalImpl(
    template: R2dbcEntityTemplate,
    converter: R2dbcConverter,
    dialect: R2dbcDialect
) : AbstractR2dbcRepository<<%= persistClass %>, <%= primaryKey.type %>>(<%= persistClass %>::class.java, template, converter, dialect),
    <%= entityClass %>RepositoryInternal {
<%_ if (toOneRelationships.length > 0 || joinTableRelationships.length > 0) { _%>

    companion object {
  <%_ if (toOneRelationships.length > 0) { _%>
        private const val SELECT_WITH_RELATIONS_SQL =
            "SELECT e.* FROM <%= entityTableName %> e"<% for (const rel of eagerToOneRelationships) { %> +
                " LEFT JOIN <%= rel.otherEntity.entityTableName %> <%= rel.relationshipSqlSafeName %> ON e.<%= rel.joinColumnNames[0] %> = <%= rel.relationshipSqlSafeName %>.<%= rel.otherEntity.primaryKey.fields[0].columnName %>"<% } %>

        private val SORT_COLUMNS = mapOf(
            "<%= primaryKey.name %>" to "e.<%= primaryKey.fields[0].columnName %>"<% for (const rel of toOneRelationships) { %>,
            "<%= rel.relationshipName %>.<%= rel.otherEntity.primaryKey.name %>" to "<% if (rel.relationshipEagerLoad) { %><%= rel.relationshipSqlSafeName %>.<%= rel.otherEntity.primaryKey.fields[0].columnName %><% } else { %>e.<%= rel.joinColumnNames[0] %><% } %>"<% if (rel.relationshipEagerLoad && rel.relatedField?.fieldSupportsSortBy && rel.relatedField.fieldName !== rel.otherEntity.primaryKey.name) { %>,
            "<%= rel.relationshipName %>.<%= rel.relatedField.fieldName %>" to "<%= rel.relationshipSqlSafeName %>.<%= rel.relatedField.fieldNameAsDatabaseColumn %>"<% } %><% } %>
        )
  <%_ } _%>
  <%_ for (const rel of joinTableRelationships) { _%>

        private val <%= joinTableConstant(rel) %> = JoinTable<<%= persistClass %>>(
            "<%= rel.joinTable.name %>",
            "<%= entityTableName %>_<%= primaryKey.hibernateSnakeCaseName %>",
            "<%= rel.joinColumnNames[0] %>"
        ) { <%= entityInstance %> -> <%= entityInstance %>.<%= rel.relationshipNamePlural %>.map { it.<%= rel.otherEntity.primaryKey.name %> } }
  <%_ } _%>
  <%_ if (joinTableRelationships.length > 0) { _%>

        private val JOIN_TABLES = listOf(<%= joinTableRelationships.map(joinTableConstant).join(', ') %>)
  <%_ } _%>
    }
<%_ } _%>
<%_ if (toOneRelationships.length > 0) { _%>

    override fun selectWithRelationsSql(): String = SELECT_WITH_RELATIONS_SQL

    override fun sortColumns(): Map<String, String> = SORT_COLUMNS
<%_ } _%>
<%_ if (populateRelations) { _%>

    override fun populateRelationships(entities: List<<%= persistClass %>>): Mono<List<<%= persistClass %>>> {
  <%_ for (const rel of referencedRelationships) { _%>
        reference(entities, { it.<%= rel.id ? primaryKey.name : `${rel.relationshipName}Id` %> }, ::<%= rel.otherEntity.persistClass %>, { related, id -> related.<%= rel.otherEntity.primaryKey.name %> = id }, { entity, related -> entity.<%= rel.relationshipName %> = related })
  <%_ } _%>
        return Mono.just(entities)<%- populateCount === 0 ? '' : '' %>
  <%_ for (const rel of eagerToOneRelationships) { _%>
            .flatMap { populated -> populate(populated, { it.<%= rel.id ? primaryKey.name : `${rel.relationshipName}Id` %> }, <%= rel.otherEntity.persistClass %>::class.java, { it.<%= rel.otherEntity.primaryKey.name %> }, { entity, related -> entity.<%= rel.relationshipName %> = related }) }
  <%_ } _%>
  <%_ for (const rel of eagerJoinTableRelationships) { _%>
            .flatMap { populated -> populate(populated, <%= joinTableConstant(rel) %>, <%= rel.otherEntity.persistClass %>::class.java, { it.<%= rel.otherEntity.primaryKey.name %> }, { entity, related -> entity.<%= rel.relationshipNamePlural %> = related.toMutableSet() }) }
  <%_ } _%>
    }
<%_ } _%>
<%_ if (joinTableRelationships.length > 0) { _%>

    override fun joinTables(): List<JoinTable<<%= persistClass %>>> = JOIN_TABLES
<%_ } _%>
<%_ if (isUsingMapsId) { _%>

    override fun <S : <%= persistClass %>> save(entity: S): Mono<S> {
        if (entity.<%= primaryKey.name %> == null && entity.<%= mapsIdAssoc.relationshipName %> != null) {
            entity.<%= primaryKey.name %> = entity.<%= mapsIdAssoc.relationshipName %>!!.<%= mapsIdAssoc.otherEntity.primaryKey.name %>
            return template.insert(entity)
        }
        return super.save(entity)
    }
<%_ } _%>
<%_ if (jpaMetamodelFiltering) { _%>

    override fun findByCriteria(criteria: <%= entityClass %>Criteria, pageable: Pageable): Flux<<%= persistClass %>> =
        findAllBy(buildCriteria(criteria), pageable)

    override fun countByCriteria(criteria: <%= entityClass %>Criteria): Mono<Long> = countBy(buildCriteria(criteria))

    private fun buildCriteria(criteria: <%= entityClass %>Criteria?): Criteria {
        val builder = CriteriaBuilder()
        if (criteria != null) {
  <%_ for (const field of fields) { _%>
    <%_ if (field.transient) continue; _%>
    <%_ if (field.filterableField) { _%>
            if (criteria.<%= field.fieldName %> != null) {
                builder.buildFilterCriteriaForField(criteria.<%= field.fieldName %>, "<%= field.fieldName %>")
            }
    <%_ } _%>
  <%_ } _%>
  <%_ for (const relationship of toOneRelationships) { _%>
            if (criteria.<%= relationship.relationshipName %>Id != null) {
                builder.buildFilterCriteriaForField(criteria.<%= relationship.relationshipName %>Id, "<%= relationship.id ? primaryKey.name : `${relationship.relationshipFieldName}Id` %>")
            }
  <%_ } _%>
        }
        return builder.buildCriteria()
    }
<%_ } _%>
}
