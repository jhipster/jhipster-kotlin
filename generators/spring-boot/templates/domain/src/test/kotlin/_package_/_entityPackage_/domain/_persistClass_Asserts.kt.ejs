package <%= entityAbsolutePackage %>.domain

import org.assertj.core.api.Assertions.assertThat

<%_ if (anyFieldIsBigDecimal) { _%>
import <%= packageName %>.domain.AssertUtils.bigDecimalCompareTo
<%_ } _%>
<%_ if (anyFieldIsZonedDateTime) { _%>
import <%= packageName %>.domain.AssertUtils.zonedDateTimeSameInstant
<%_ } _%>

object <%= persistClass %>Asserts {

    /**
     * Asserts that the entity has all properties (fields/relationships) set.
     *
     * @param expected the expected entity
     * @param actual the actual entity
     */
    fun assert<%= persistClass %>AllPropertiesEquals(expected: <%= persistClass %>, actual: <%= persistClass %>) {
        assert<%= persistClass %>AutoGeneratedPropertiesEquals(expected, actual)
        assert<%= persistClass %>AllUpdatablePropertiesEquals(expected, actual)
    }

    /**
     * Asserts that the entity has all updatable properties (fields/relationships) set.
     *
     * @param expected the expected entity
     * @param actual the actual entity
     */
    fun assert<%= persistClass %>AllUpdatablePropertiesEquals(expected: <%= persistClass %>, actual: <%= persistClass %>) {
        assert<%= persistClass %>UpdatableFieldsEquals(expected, actual)
        assert<%= persistClass %>UpdatableRelationshipsEquals(expected, actual)
    }
<%_ if (!embedded && primaryKey.derived) { _%>

    /**
     * Asserts that the derived primary key is set correctly.
     *
     * @param entityToPersist the entity used to persist
     * @param persisted the persisted entity
     */
    fun assert<%= persistClass %>MapsIdRelationshipPersistedValue(entityToPersist: <%= persistClass %>, persisted: <%= persistClass %>) {
        // Validate the id for MapsId, the ids must be same
        assertThat(entityToPersist.<%= primaryKey.relationships[0].relationshipFieldName %>?.<%= primaryKey.name %>).isEqualTo(persisted.<%= primaryKey.name %>)
    }
<%_ } _%>

    /**
     * Asserts that the entity has all the auto generated properties (fields/relationships) set.
     *
     * @param expected the expected entity
     * @param actual the actual entity
     */
    fun assert<%= persistClass %>AutoGeneratedPropertiesEquals(expected: <%= persistClass %>, actual: <%= persistClass %>) {
<%_ if (fields.some(field => !field.transient && field.autoGenerate)) { _%>
        assertThat(actual)
            .`as`("Verify <%= persistClass %> auto generated properties")
  <%_ for (const field of fields.filter(field => !field.transient && field.autoGenerate)) { _%>
            .satisfies({ a -> assertThat(a.<%= field.fieldName %>).`as`("check <%= field.fieldName %>").isEqualTo(expected.<%= field.fieldName %>) })
  <%_ } _%>
  <%_ for (const relationship of relationships.filter(relationship => (!embedded || relationship.otherEntity.embedded) && relationship.autoGenerate && !relationship.otherEntity.builtInUser)) { _%>
            .satisfies({ a -> assertThat(a.<%= relationship.collection ? relationship.relationshipFieldNamePlural : relationship.relationshipFieldName %>).`as`("check <%= relationship.relationshipName %>").isEqualTo(expected.<%= relationship.collection ? relationship.relationshipFieldNamePlural : relationship.relationshipFieldName %>) })
  <%_ } _%>
<%_ } else { _%>
        // empty method
<%_ } _%>
    }

    /**
     * Asserts that the entity has all the updatable fields set.
     *
     * @param expected the expected entity
     * @param actual the actual entity
     */
    fun assert<%= persistClass %>UpdatableFieldsEquals(expected: <%= persistClass %>, actual: <%= persistClass %>) {
<%_ if (fields.some(field => !field.transient && !field.autoGenerate)) { _%>
        assertThat(actual)
            .`as`("Verify <%= persistClass %> relevant properties")
  <%_ for (const field of fields.filter(field => !field.transient && !field.autoGenerate)) { _%>
    <%_ if (field.fieldTypeZonedDateTime) { _%>
            .satisfies({ a -> assertThat(a.<%= field.fieldName %>).`as`("check <%= field.fieldName %>").usingComparator(zonedDateTimeSameInstant).isEqualTo(expected.<%= field.fieldName %>) })
    <%_ } else if (field.fieldTypeBigDecimal) { _%>
            .satisfies({ a -> assertThat(a.<%= field.fieldName %>).`as`("check <%= field.fieldName %>").usingComparator(bigDecimalCompareTo).isEqualTo(expected.<%= field.fieldName %>) })
    <%_ } else { _%>
            .satisfies({ a -> assertThat(a.<%= field.fieldName %>).`as`("check <%= field.fieldName %>").isEqualTo(expected.<%= field.fieldName %>) })
      <%_ if (field.fieldTypeBinary && !field.blobContentTypeText) { _%>
            .satisfies({ a -> assertThat(a.<%= field.fieldName %>ContentType).`as`("check <%= field.fieldName %> content type").isEqualTo(expected.<%= field.fieldName %>ContentType) })
      <%_ } -%>
    <%_ } -%>
  <%_ } -%>
<%_ } else { _%>
        // empty method
<%_ } _%>
    }

    /**
     * Asserts that the entity has all the updatable relationships set.
     *
     * @param expected the expected entity
     * @param actual the actual entity
     */
    fun assert<%= persistClass %>UpdatableRelationshipsEquals(expected: <%= persistClass %>, actual: <%= persistClass %>) {
<%_ if (relationships.some(relationship => relationship.persistableRelationship && !relationship.id && !relationship.autoGenerate && !relationship.otherEntity.builtInUser)) { _%>
        assertThat(actual)
            .`as`("Verify <%= persistClass %> relationships")
  <%_ for (const relationship of relationships.filter(relationship => (!embedded || relationship.otherEntity.embedded) && relationship.persistableRelationship && !relationship.id && !relationship.autoGenerate && !relationship.otherEntity.builtInUser)) { _%>
            .satisfies({ a -> assertThat(a.<%= relationship.collection ? relationship.relationshipFieldNamePlural : relationship.relationshipFieldName %>).`as`("check <%= relationship.relationshipName %>").isEqualTo(expected.<%= relationship.collection ? relationship.relationshipFieldNamePlural : relationship.relationshipFieldName %>) })
  <%_ } _%>
<%_ } else { _%>
        // empty method
<%_ } _%>
    }
}
