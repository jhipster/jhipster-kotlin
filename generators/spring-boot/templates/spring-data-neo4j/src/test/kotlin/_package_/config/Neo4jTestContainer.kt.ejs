package <%= packageName %>.config

import org.slf4j.LoggerFactory
import org.springframework.boot.test.context.TestConfiguration
import org.springframework.boot.testcontainers.service.connection.ServiceConnection
import org.springframework.context.annotation.Bean
<%_ if (databaseMigrationLiquibase) { _%>
import org.springframework.test.context.DynamicPropertyRegistrar
<%_ } _%>
import org.testcontainers.containers.Neo4jContainer
import org.testcontainers.containers.output.Slf4jLogConsumer
import org.testcontainers.utility.DockerImageName

@TestConfiguration(proxyBeanMethods = false)
class Neo4jTestContainer {

    companion object {
        private val NEO4J_CONTAINER: Neo4jContainer<*> = Neo4jContainer(DockerImageName.parse("<%= dockerContainers.neo4j %>"))
            .withoutAuthentication()
            .withLogConsumer(Slf4jLogConsumer(LoggerFactory.getLogger(Neo4jTestContainer::class.java)))
    }

    @Bean
    @ServiceConnection
    fun neo4jContainer(): Neo4jContainer<*> = NEO4J_CONTAINER
<%_ if (databaseMigrationLiquibase) { _%>

    @Bean
    fun neo4jProperties(neo4jContainer: Neo4jContainer<*>): DynamicPropertyRegistrar {
        return DynamicPropertyRegistrar { registry ->
            registry.add("spring.liquibase.url") { "jdbc:neo4j:" + neo4jContainer.boltUrl }
        }
    }
<%_ } _%>
}
