package <%= packageName %>.broker

import kotlinx.coroutines.channels.BufferOverflow
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.MutableSharedFlow
import kotlinx.coroutines.flow.asSharedFlow
import org.slf4j.LoggerFactory
import org.springframework.stereotype.Component
import java.util.function.Consumer

@Component
class KafkaConsumer : Consumer<String> {

    private val _flow = MutableSharedFlow<String>(replay = 0, extraBufferCapacity = 256, onBufferOverflow = BufferOverflow.DROP_OLDEST)

    fun getFlow(): Flow<String> = _flow.asSharedFlow()

    override fun accept(input: String) {
        log.debug("Got message from kafka stream: {}", input)
        _flow.tryEmit(input)
    }

    companion object {
        private val log = LoggerFactory.getLogger(KafkaConsumer::class.java)
    }
}
