package <%= packageName %>.web.rest

import <%= packageName %>.IntegrationTest
import org.assertj.core.api.Assertions.assertThat
<%_ if (authenticationUsesCsrf) { _%>
import org.junit.jupiter.api.BeforeEach
<%_ } _%>
import org.junit.jupiter.api.Test
import org.springframework.beans.factory.annotation.Autowired
import org.springframework.boot.autoconfigure.ImportAutoConfiguration
import org.springframework.boot.webtestclient.autoconfigure.AutoConfigureWebTestClient
import org.springframework.cloud.stream.binder.test.InputDestination
import org.springframework.cloud.stream.binder.test.OutputDestination
import org.springframework.cloud.stream.binder.test.TestChannelBinderConfiguration
import org.springframework.http.MediaType
import org.springframework.messaging.MessageHeaders
import org.springframework.messaging.support.GenericMessage
import org.springframework.security.test.context.support.WithMockUser
<%_ if (authenticationUsesCsrf) { _%>
import org.springframework.security.test.web.reactive.server.SecurityMockServerConfigurers.csrf
<%_ } _%>
import org.springframework.test.context.TestPropertySource
import org.springframework.test.web.reactive.server.WebTestClient
import org.springframework.util.MimeTypeUtils
import java.time.Duration

@IntegrationTest
@AutoConfigureWebTestClient(timeout = IntegrationTest.DEFAULT_TIMEOUT)
@WithMockUser
@ImportAutoConfiguration(TestChannelBinderConfiguration::class)
@TestPropertySource(properties = ["spring.profiles.include=kafka"])
class <%= upperFirstCamelCaseBaseName %>KafkaResourceIT {

    @Autowired
    private lateinit var client: WebTestClient

    @Autowired
    private lateinit var input: InputDestination

    @Autowired
    private lateinit var output: OutputDestination
<%_ if (authenticationUsesCsrf) { _%>

    @BeforeEach
    fun setupCsrf() {
        client = client.mutateWith(csrf())
    }
<%_ } _%>

    @Test
    fun producesMessages() {
        client
            .post()
            .uri { uriBuilder -> uriBuilder.path(KAFKA_API).queryParam("message", "value-produce").build("publish") }
            .exchange()
            .expectStatus()
            .isNoContent
        assertThat(output.receive(1000, "binding-out-0").payload).isEqualTo("value-produce".toByteArray())
    }

    @Test
    fun producesPooledMessages() {
        assertThat(output.receive(1500, "kafkaProducer-out-0").payload).isEqualTo("kafka_producer".toByteArray())
    }

    @Test
    fun consumesMessages() {
        val headers = MessageHeaders(mapOf<String, Any>(MessageHeaders.CONTENT_TYPE to MimeTypeUtils.TEXT_PLAIN_VALUE))
        val testMessage = GenericMessage("value-consume", headers)
        input.send(testMessage)
        val value = client
            .get()
            .uri(KAFKA_API, "consume")
            .accept(MediaType.TEXT_EVENT_STREAM)
            .exchange()
            .expectStatus()
            .isOk
            .expectHeader()
            .contentTypeCompatibleWith(MediaType.TEXT_EVENT_STREAM)
            .returnResult(String::class.java)
            .responseBody
            .blockFirst(Duration.ofSeconds(10))
        assertThat(value).isEqualTo("value-consume")
    }

    companion object {
        private const val KAFKA_API = "/api/<%= dasherizedBaseName %>-kafka/{command}"
    }
}
